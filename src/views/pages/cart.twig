{#
  Cart — Raed's functional markup (forms, Salla components, hooks) re-skinned
  with the Mussdl design. Nothing about how the cart works is changed here.
#}
{% extends "layouts.mussdl" %}
{# Salla pins the summary card to the bottom on phones; keep the footer clear of it. #}
{% block body_class %}pb-28 lg:pb-0{% endblock %}
{% block content %}
<div class="shell pt-8 sm:pt-12">
  <nav class="text-[12.5px] text-ink-soft" aria-label="مسار التنقل"><salla-breadcrumb></salla-breadcrumb></nav>
  <header class="mt-5" data-stagger="80">
    <span class="eyebrow" data-reveal="down">الخطوة ١ من ٣</span>
    <h1 class="h-display text-sect mt-3 text-olive" data-reveal="up">{{ trans('blocks.header.cart') }}</h1>
  </header>

  <salla-conditional-offer data-testid="store-cart-conditional-offer" class="mt-6 block"></salla-conditional-offer>

  <div class="mt-8 flex flex-col items-start gap-8 pb-24 lg:flex-row lg:pb-20">
    <div class="w-full lg:w-[calc(100%-384px)]">
      {% hook 'cart:items.start' %}

      {% for item in cart.items %}
        <form onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ item.id }}">
          <section data-testid="store-cart-item-{{ item.id }}" class="card relative mb-4 p-5 sm:p-6">
            <input type="hidden" name="id" value="{{ item.id }}">
            <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
              <div class="flex flex-1 gap-4">
                <a href="{{ item.url }}" class="relative shrink-0 overflow-hidden rounded-xl border border-ink/8 bg-shell">
                  <img src="{{ item.product_image }}" alt="{{ item.product_name }}" loading="{{ loop.first ? 'eager' : 'lazy' }}" class="h-24 w-24 object-cover"/>
                  <div class="free-ribbon absolute top-[11px] right-[-38px] w-32 rotate-45 bg-red-600 py-1 text-center text-xs font-bold text-white shadow-md {{ (item.price.getMoney().amount == 0 and item.has_discount) ? '' : 'hidden' }}">{{ trans('pages.loyalty_program.free_product') }}</div>
                </a>
                <div class="space-y-1">
                  <h2 class="text-[16px] font-medium text-olive"><a href="{{ item.url }}">{{ item.product_name }}</a></h2>
                  <span class="item-regular-price num text-[13px] text-ink-soft line-through {{ item.offer ? '' : 'hidden' }}">{{ item.product_price|money }}</span>
                  <span class="item-original-price num inline-flex gap-1 text-[13px] text-ink-soft line-through {{ item.is_on_sale ? '' : 'hidden' }}" id="original_price">{{ item.original_price|money }}</span>
                  <span data-testid="store-cart-item-price" class="item-price num inline-flex gap-1 text-[14px] {{ item.has_discount ? 'text-gold-ink' : 'text-ink' }}" id="has_discount">{{ item.price|money }}</span>
                  <p class="item-weight-row text-[13px] text-ink-soft {{ item.weight_label ? '' : 'hidden' }}">{{ trans('pages.products.weight') }} <span class="item-weight">{{ item.weight_label }}</span></p>
                  <span class="old-offers flex items-center gap-1 {{ item.detailed_offers ? 'hidden' : '' }}">
                    <i class="sicon-discount-calculator offer-icon text-ink-soft {{ item.offer ? '' : 'hidden' }}"></i>
                    <span class="offer-name text-[13px] text-ink-soft {{ item.offer ? '' : 'hidden' }}">{{ item.offer.names }}</span>
                  </span>
                  <salla-cart-item-offers quantity="{{ item.quantity }}" item-id="{{ item.id }}" product-price="{{ item.product_price }}" offers="{{ item.detailed_offers|json_encode }}"></salla-cart-item-offers>
                </div>
              </div>

              <div class="flex items-center justify-between gap-6 border-t border-ink/10 pt-4 md:border-0 md:pt-0">
                {% if item.type == 'donating' %}
                  <span></span>
                {% elseif item.is_hidden_quantity %}
                  <input type="hidden" value="{{ item.quantity }}" name="quantity" aria-label="Quantity"/>
                  <span class="num w-10 text-center">{{ item.quantity }}</span>
                {% else %}
                  <salla-quantity-input cart-item-id="{{ item.id }}" max="{{ item.max_quantity }}" aria-label="Quantity" value="{{ item.quantity }}" name="quantity"
                                        class="rounded-full border border-ink/15 bg-shell/70"></salla-quantity-input>
                {% endif %}
                {% set item_total = item.detailed_offers|length > 0 ? item.total_special_price|money : item.total|money %}
                <p class="shrink-0 text-[14px] text-olive">
                  <span class="text-ink-soft">{{ trans('pages.cart.total') }}:</span>
                  <span data-testid="store-cart-item-total" class="item-total num inline-block font-semibold">{{ item.is_available ? item_total : trans('pages.cart.out_of_stock') }}</span>
                </p>
              </div>
            </div>

            <div class="mussdl-options">{% include 'pages.partials.product.options' with {product: item} %}</div>

            <span class="absolute top-3 left-3">
              <salla-button data-testid="store-cart-delete-item" type="button" shape="icon" size="small" color="danger" class="btn--delete" aria-label="Remove from the cart"
                            onclick="salla.cart.deleteItem('{{ item.id }}').then(() => document.querySelector('#item-{{ item.id }}').remove())">
                <i class="sicon-cancel"></i>
              </salla-button>
            </span>
          </section>
        </form>
      {% else %}
        <div data-testid="store-cart-empty" class="card flex flex-col items-center gap-4 p-10 text-center">
          <i class="sicon-shopping-bag text-4xl text-ink-soft"></i>
          <p class="text-[16px] text-ink">{{ trans('pages.cart.empty_cart') }}</p>
          <a data-testid="store-cart-back-home" href="{{ theme.settings.get('mussdl_product_url') ?: link('/') }}" class="btn-primary" data-product-link>تسوقي المنتج</a>
        </div>
      {% endfor %}

      {% if cart.options|length %}
        <div class="cart-options">
          {% for product_option in cart.options %}
            <form class="relative first:pt-5" onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ product_option.id }}">
              <input type="hidden" name="id" value="{{ product_option.id }}">
              <input type="hidden" name="quantity" value="{{ product_option.quantity }}">
              {% include 'pages.partials.product.options' with { product: product_option } %}
            </form>
          {% endfor %}
        </div>
      {% endif %}

      <salla-offer data-testid="store-cart-offer"></salla-offer>
      {% hook 'cart:items.end' %}
    </div>

    {% hook 'cart:summary.start' %}
    {% if cart.items|length %}
      <div class="sticky top-24 w-full lg:w-96">
        <div class="card mb-4 p-5 {{ cart.free_shipping_bar ? '' : 'hidden' }}" id="free-shipping">
          <div class="flex items-center gap-3">
            <i class="sicon-shipping-fast flex h-9 w-9 items-center justify-center rounded-full bg-olive text-gold"></i>
            {% set is_free = cart.free_shipping_bar.has_free_shipping %}
            <div class="flex-1">
              <h4 class="text-[14px] font-medium text-olive">{{ trans('pages.cart.free_shipping') }}</h4>
              <p class="text-[13px] text-ink-soft">
                <span id="free-shipping-msg">{{ (is_free ? trans('pages.cart.has_free_shipping') : trans('pages.cart.free_shipping_alert', {'amount': cart.free_shipping_bar.remaining|money}))|raw }}</span>
                <span class="emoji {{ is_free ? '' : 'hidden' }}" id="free-shipping-applied">🎉</span>
              </p>
            </div>
          </div>
          <div class="mt-5 h-2 rounded-full bg-cream-deep {{ is_free ? 'hidden' : '' }}" id="free-shipping-bar">
            <div class="progress-bg relative h-2 rounded-full bg-gradient-to-l from-gold to-olive transition-all duration-500" style="width:{{ cart.free_shipping_bar.percent }}%"></div>
          </div>
        </div>

        {% if loyalty %}
          <salla-loyalty-panel data-testid="store-cart-loyalty" prize-points='{{ loyalty.prize.points }}' prize-title='{{ loyalty.prize.title }}'></salla-loyalty-panel>
        {% endif %}

        <div id="cart-gifting" class="card mb-4 p-2 {{ gift.enabled ? '' : 'hidden' }}">
          <salla-gifting data-testid="store-cart-gifting" id="salla-gifting" widget-title="{{ trans('pages.cart.gift_widget_title') }}" widget-subtitle="{{ gift.text }}" {{ gift.type }}-products vertical></salla-gifting>
        </div>

        {% if store.settings.cart.apply_coupon_enabled %}
          <div class="card mb-4 px-5">
            {% hook 'cart:coupon.start' %}
            <salla-cart-coupons data-testid="store-cart-coupons"></salla-cart-coupons>
            {% hook 'cart:coupon.end' %}
          </div>
        {% endif %}

        {% hook 'cart:summary-card.start' %}
        <div class="lg:rounded-[var(--radius-card)] lg:border lg:border-ink/8 lg:bg-shell/85 lg:p-1 lg:shadow-[0_14px_38px_-24px_rgba(60,65,74,.45)]">
          <salla-cart-summary-card data-testid="store-cart-summary"></salla-cart-summary-card>
        </div>
        {% hook 'cart:summary-card.end' %}
        {% hook 'cart:summary.end' %}
        <salla-tiered-offer data-testid="store-cart-tiered-offer"></salla-tiered-offer>
      </div>
    {% endif %}
  </div>
</div>
{% endblock %}

{% block scripts %}
  <script defer src="{{ 'checkout.js' | asset }}"></script>
{% endblock %}

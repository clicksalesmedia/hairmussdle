{#
  Products listing — Salla routes categories, "all products", search results,
  offers, brand and tag pages to this one template. The grid is Salla's
  `salla-products-list`, which renders the platform's built-in product card
  (Raed's custom card is not loaded in this layout); sorting and the `?sort=`
  param are wired in mussdl.js.

  | Variable                   | Type        |
  | page.title / page.slug     | string      |
  | category                   | ?Category   | (sub_categories deliberately not touched: the lookup stalls the page) |
  | filters                    | bool        |
  | sort_options[] {id,name,is_selected} |   |
  | search_query               | ?string     |
#}
{% extends "layouts.mussdl" %}
{% block content %}
<div class="shell pt-6 sm:pt-8" data-products-page>

  <nav class="mb-5 text-[12.5px] text-ink-soft sm:mb-7" aria-label="مسار التنقل"><salla-breadcrumb></salla-breadcrumb></nav>
  <div class="s-blocks-wrapper">{% hook 'product.index.before_products_group_with_filter' %}</div>

  <header class="flex flex-wrap items-end justify-between gap-4" data-stagger="80">
    <div class="min-w-0">
      <span class="eyebrow" data-reveal="down">{{ search_query ? 'نتائج البحث' : 'المتجر' }}</span>
      <h1 id="page-main-title" class="h-display text-sect mt-3 text-olive" data-reveal="up">{{ page.title|raw }}</h1>
    </div>

    {% if sort_options|length %}
      <div class="flex items-center gap-2" data-reveal="up">
        <label class="text-[13px] text-ink-soft" for="product-filter">{{ trans('pages.categories.sorting') }}</label>
        <select id="product-filter" class="field w-auto py-2 pl-9 text-[13.5px]">
          {% for sort in sort_options %}
            <option value="{{ sort.id }}" {{ sort.is_selected ? 'selected' : '' }}>{{ sort.name }}</option>
          {% endfor %}
        </select>
      </div>
    {% endif %}
  </header>

  <div class="mt-8 flex flex-col items-start gap-8 lg:flex-row lg:gap-10">
    {% if filters %}
      <salla-filters data-testid="store-products-filters" id="filters-menu"
                     class="card w-full p-4 lg:sticky lg:top-24 lg:w-72 lg:flex-none"></salla-filters>
    {% endif %}

    <div class="w-full min-w-0 flex-1">
      {% hook 'product:index.items.start' %}
      <salla-products-list data-testid="store-products-list" class="mussdl-products block"
                           source="{{ page.slug }}" source-value="{{ page.id }}" {{ filters ? 'filters-results' : '' }}></salla-products-list>
      {% hook 'product:index.items.end' %}
    </div>
  </div>

  <div class="s-blocks-wrapper">{% hook 'product.index.after_products_group_with_filter' %}</div>
  <div class="s-blocks-wrapper">{% hook 'product.index.after_testimonials' %}</div>
</div>
{% endblock %}

{#
  Mussdl header. Static brand navigation (single-product store) plus Salla's
  own cart summary and account menu, which handle the live state.
#}
{% import 'components.mussdl.links' as mussdl_links %}
{% set product_path = 'معزز-النمو-بالقرنفل/p2020016513' %}
{% set product_url = mussdl_links.store_url(theme.settings.get('mussdl_product_url'), product_path)|trim %}
{# Salla only hands back what the merchant saved, so the twilight.json default is repeated here. #}
{% set offer_text  = theme.settings.get('mussdl_offer_text', 'عروض اليوم الوطني: عبوتان بـ ١٠٩ ر.س بدل ٢١٨ · ثلاث عبوات بـ ١٤٩ ر.س') %}
{% set home = link('/') %}
{% set show_offers = theme.settings.get('mussdl_show_offers', true) %}
{% set nav = [{ label: 'المنتج', href: product_url, product: true }] %}
{% if show_offers %}{% set nav = nav|merge([{ label: 'عروض اليوم الوطني', href: home ~ '#offers' }]) %}{% endif %}
{% set nav = nav|merge([
    { label: 'لماذا مسدل',       href: home ~ '#benefits' },
    { label: 'المكونات',         href: home ~ '#ingredients' },
    { label: 'النتائج',          href: home ~ '#results' },
    { label: 'طريقة الاستخدام',  href: home ~ '#ritual' },
    { label: 'عن مسدل',          href: home ~ '#about' }
]) %}

<header data-testid="store-header" class="sticky top-0 z-50 border-b border-ink/10 bg-cream/85 backdrop-blur" data-site-header>

  {% if theme.settings.get('mussdl_show_offer_bar', true) and offer_text %}
    <div class="relative bg-olive text-cream" data-offer-bar>
      <div class="shell flex items-center justify-center gap-2 py-1.5 pl-10 pr-3 text-center text-[11.5px] leading-snug sm:gap-3 sm:py-2 sm:pl-12 sm:text-[12.5px]">
        <span class="text-gold">◆</span>
        <span>{{ offer_text }}</span>
        <button type="button" class="absolute left-1 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full text-[18px] leading-none text-cream/70 transition hover:bg-cream/10 hover:text-cream sm:left-2" data-offer-close aria-label="إغلاق">×</button>
      </div>
    </div>
  {% endif %}

  <div class="shell flex h-16 items-center justify-between gap-3 lg:h-[72px] lg:gap-4">

    {# Brand #}
    <a href="{{ home }}" class="group flex shrink-0 items-center" aria-label="{{ store.name }}">
      <img src="{{ 'images/mussdl/logo-olive.webp'|asset }}" alt="{{ store.name }}" width="644" height="200"
           class="h-9 w-auto transition-opacity group-hover:opacity-80 sm:h-11" fetchpriority="high"/>
      {% if is_page('index') %}<h1 class="sr-only">{{ store.name }}</h1>{% else %}<h2 class="sr-only">{{ store.name }}</h2>{% endif %}
    </a>

    {# Desktop nav #}
    <nav class="hidden items-center gap-7 lg:flex" aria-label="التنقل الرئيسي">
      {% for item in nav %}
        <a href="{{ item.href }}" class="text-[14px] text-ink transition-colors hover:text-olive" {{ item.product ? 'data-product-link' : '' }}>{{ item.label }}</a>
      {% endfor %}
    </nav>

    {# Actions #}
    <div class="flex items-center gap-2 sm:gap-3">
      <span class="hidden items-center gap-1.5 text-[12px] text-ink-soft xl:flex">
        <i class="sicon-shipping-fast text-gold-ink"></i>
        شحن سريع لجميع دول الخليج
      </span>

      <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger
                       class="hidden sm:block"></salla-user-menu>

      <salla-cart-summary data-testid="store-header-cart"
                          class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-shell/80 px-4 py-2 text-[13px] text-ink">
        <i slot="icon" class="sicon-shopping-bag"></i>
      </salla-cart-summary>

      <button type="button" data-menu-open aria-expanded="false" aria-controls="mussdl-mobile-nav"
              class="flex h-10 w-10 items-center justify-center rounded-full text-ink transition hover:bg-ink/5 lg:hidden"
              aria-label="فتح القائمة">
        <i class="sicon-menu text-xl"></i>
      </button>
    </div>
  </div>
</header>

{# Mobile drawer — outside <header>: its backdrop-blur would otherwise trap this fixed panel inside the bar. #}
  <div id="mussdl-mobile-nav" class="fixed inset-0 z-[60] hidden" data-menu-root>
    <div class="absolute inset-0 bg-ink/40 opacity-0 transition-opacity duration-300" data-menu-scrim></div>
    <div class="absolute inset-y-0 right-0 flex w-[82%] max-w-[340px] translate-x-full flex-col bg-cream shadow-2xl
                transition-transform duration-[400ms] ease-[cubic-bezier(.16,1,.3,1)]" data-menu-panel>
      <div class="flex items-center justify-between border-b border-ink/10 px-5 py-4">
        <img src="{{ 'images/mussdl/logo-olive.webp'|asset }}" alt="{{ store.name }}" width="644" height="200" class="h-9 w-auto"/>
        <button type="button" data-menu-close class="flex h-10 w-10 items-center justify-center rounded-full text-ink transition hover:bg-ink/5" aria-label="إغلاق القائمة">
          <i class="sicon-cancel text-xl"></i>
        </button>
      </div>
      <nav class="flex flex-col px-5 py-4" aria-label="قائمة الجوال">
        {% for item in nav %}
          <a href="{{ item.href }}" class="border-b border-ink/8 py-3.5 text-[16px] text-ink" data-menu-link {{ item.product ? 'data-product-link' : '' }}>{{ item.label }}</a>
        {% endfor %}
      </nav>
      <div class="mt-auto space-y-3 px-5 pb-6">
        <a href="{{ product_url }}" class="btn-primary w-full" data-product-link>اطلبي العبوة الآن</a>
        <div class="flex justify-center"><salla-user-menu show-trigger></salla-user-menu></div>
      </div>
    </div>
  </div>
